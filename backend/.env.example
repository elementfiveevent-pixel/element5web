# Backend server configuration
# Copy this file to .env for local development.

NODE_ENV=development
PORT=4000

# Supabase PostgreSQL connection strings.
# DATABASE_URL should usually use the Supabase pooler URL.
# DIRECT_URL should use the direct database URL when needed.
DATABASE_URL=
DIRECT_URL=

# Auth/session settings.
# Generate strong private values for JWT_SECRET and ADMIN_TOTP_SECRET.
JWT_SECRET=
JWT_EXPIRATION=15m
ADMIN_TOTP_SECRET=

# Comma-separated frontend origins allowed to call the backend.
# Local example: http://localhost:3000,http://127.0.0.1:3000
# Production example: https://your-vercel-project.vercel.app
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Supabase Storage upload configuration.
# Use the project URL and anon key, not the service_role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional Cloudinary signed upload configuration.
# If blank, the backend returns mock upload signatures.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Redis configuration.
# If Redis is not running locally, the backend starts with caching disabled.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
